# --- Local LLM (Ollama) ---
# Start Ollama: https://ollama.com  →  ollama pull llama3.1
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.1

# --- TTS Provider ---
# Options: edge-tts | windows-sapi | stub
# edge-tts requires: pip install edge-tts
# windows-sapi uses built-in Windows Speech API (WAV output, lower quality)
# stub runs without audio (useful for testing the pipeline)
TTS_PROVIDER=edge-tts
TTS_VOICE=en-US-GuyNeural

# --- Server ---
SCENE_PORT=3000

# --- Pipeline ---
# Minimum seconds between topics
MIN_TOPIC_DURATION_SECONDS=60
# Maximum topics to keep in seen history before resetting
MAX_SEEN_HISTORY=500

# --- Paths ---
EPISODE_DB_PATH=./data/episodes.json
# Folder where audio files are saved (served at /audio/)
AUDIO_OUTPUT_DIR=./public/audio
# How many audio files to keep before deleting the oldest
AUDIO_KEEP_COUNT=10

# --- Discord voice streaming (optional) ---
# Leave blank to disable — the stream will just run via scene.html/OBS as before.
# Create a bot at https://discord.com/developers/applications, invite it to your
# server with the "bot" scope and Connect + Speak permissions on the target channel.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=
